2=\"110\" y2=\"46\" stroke=\"#23272e\" stroke-width=\"2\" stroke-linecap=\"round\"/><circle cx=\"40\" cy=\"61.92\" r=\"2.8\" fill=\"#23272e\" stroke=\"#23272e\" stroke-width=\"1\"/><circle cx=\"110\" cy=\"46\" r=\"2.8\" fill=\"#23272e\" stroke=\"#23272e\" stroke-width=\"1\"/></svg><circle cx=\"22\" cy=\"180\" r=\"10\" fill=\"#ffffff\" stroke=\"#6b7280\" stroke-width=\"1.6\"/><text x=\"22\" y=\"180.5\" font-size=\"11\" fill=\"#6b7280\" text-anchor=\"middle\" font-weight=\"800\" dominant-baseline=\"middle\">A</text><svg x=\"176\" y=\"166\" width=\"160\" height=\"128\" viewBox=\"0 0 150 120\"><rect x=\"1\" y=\"1\" width=\"148\" height=\"118\" rx=\"6\" fill=\"#ffffff\" stroke=\"#c3cad3\" stroke-width=\"1.2\"/><polygon points=\"64.15,46 27.93,25.09 27.92,66.91\" fill=\"#eef1f5\" stroke=\"#23272e\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/><polygon points=\"131,54 130.82,51.26 130.28,48.56 129.4,45.96 128.19,43.5 126.66,41.22 124.85,39.15 122.78,37.34 120.5,35.81 118.04,34.6 115.44,33.72 112.74,33.18 110,33 107.26,33.18 104.56,33.72 101.96,34.6 99.5,35.81 97.22,37.34 95.15,39.15 93.34,41.22 91.81,43.5 90.6,45.96 89.72,48.56 89.18,51.26 89,54 89.18,56.74 89.72,59.44 90.6,62.04 91.81,64.5 93.34,66.78 95.15,68.85 97.22,70.66 99.5,72.19 101.96,73.4 104.56,74.28 107.26,74.82 110,75 112.74,74.82 115.44,74.28 118.04,73.4 120.5,72.19 122.78,70.66 124.85,68.85 126.66,66.78 128.19,64.5 129.4,62.04 130.28,59.44 130.82,56.74\" fill=\"#eef1f5\" stroke=\"#23272e\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/><line x1=\"64.15\" y1=\"46\" x2=\"89\" y2=\"54\" stroke=\"#23272e\" stroke-width=\"2\" stroke-linecap=\"round\"/><circle cx=\"64.15\" cy=\"46\" r=\"2.8\" fill=\"#23272e\" stroke=\"#23272e\" stroke-width=\"1\"/><circle cx=\"89\" cy=\"54\" r=\"2.8\" fill=\"#23272e\" stroke=\"#23272e\" stroke-width=\"1\"/></svg><circle cx=\"190\" cy=\"180\" r=\"10\" fill=\"#ffffff\" stroke=\"#6b7280\" stroke-width=\"1.6\"/><text x=\"190\" y=\"180.5\" font-size=\"11\" fill=\"#6b7280\" text-anchor=\"middle\" font-weight=\"800\" dominant-baseline=\"middle\">B</text><svg x=\"344\" y=\"166\" width=\"160\" height=\"128\" viewBox=\"0 0 150 120\"><rect x=\"1\" y=\"1\" width=\"148\" height=\"118\" rx=\"6\" fill=\"#ffffff\" stroke=\"#c3cad3\" stroke-width=\"1.2\"/><polygon points=\"40,41.85 19.09,78.08 60.91,78.08\" fill=\"#eef1f5\" stroke=\"#23272e\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/><polygon points=\"126.09,40.5 124.19,38.52 122.05,36.8 119.7,35.37 117.18,34.27 114.55,33.5 111.83,33.08 109.08,33.02 106.35,33.32 103.69,33.97 101.13,34.97 98.72,36.29 96.5,37.91 94.52,39.81 92.8,41.95 91.37,44.3 90.27,46.82 89.5,49.45 89.08,52.17 89.02,54.92 89.32,57.65 89.97,60.31 90.97,62.87 92.29,65.28 93.91,67.5 95.81,69.48 97.95,71.2 100.3,72.63 102.82,73.73 105.45,74.5 108.17,74.92 110.92,74.98 113.65,74.68 116.31,74.03 118.87,73.03 121.28,71.71 123.5,70.09 125.48,68.19 127.2,66.05 128.63,63.7 129.73,61.18 130.5,58.55 130.92,55.83 130.98,53.08 130.68,50.35 130.03,47.69 129.03,45.13 127.71,42.72\" fill=\"#eef1f5\" stroke=\"#23272e\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/><line x1=\"40\" y1=\"41.85\" x2=\"110\" y2=\"54\" stroke=\"#23272e\" stroke-width=\"2\" stroke-linecap=\"round\"/><circle cx=\"40\" cy=\"41.85\" r=\"2.8\" fill=\"#23272e\" stroke=\"#23272e\" stroke-width=\"1\"/><circle cx=\"110\" cy=\"54\" r=\"2.8\" fill=\"#23272e\" stroke=\"#23272e\" stroke-width=\"1\"/></svg><circle cx=\"358\" cy=\"180\" r=\"10\" fill=\"#2f8a57\" stroke=\"#2f8a57\" stroke-width=\"1.6\"/><text x=\"358\" y=\"180.5\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"800\" dominant-baseline=\"middle\">C</text><svg x=\"512\" y=\"166\" width=\"160\" height=\"128\" viewBox=\"0 0 150 120\"><rect x=\"1\" y=\"1\" width=\"148\" height=\"118\" rx=\"6\" fill=\"#ffffff\" stroke=\"#c3cad3\" stroke-width=\"1.2\"/><polygon points=\"64.15,46 27.93,25.09 27.92,66.91\" fill=\"#eef1f5\" stroke=\"#23272e\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/><polygon points=\"96.5,57.91 94.52,59.81 92.8,61.95 91.37,64.3 90.27,66.82 89.5,69.45 89.08,72.17 89.02,74.92 89.32,77.65 89.97,80.31 90.97,82.87 92.29,85.28 93.91,87.5 95.81,89.48 97.95,91.2 100.3,92.63 102.82,93.73 105.45,94.5 108.17,94.92 110.92,94.98 113.65,94.68 116.31,94.03 118.87,93.03 121.28,91.71 123.5,90.09 125.48,88.19 127.2,86.05 128.63,83.7 129.73,81.18 130.5,78.55 130.92,75.83 130.98,73.08 130.68,70.35 130.03,67.69 129.03,65.13 127.71,62.72 126.09,60.5 124.19,58.52 122.05,56.8 119.7,55.37 117.18,54.27 114.55,53.5 111.83,53.08 109.08,53.02 106.35,53.32 103.69,53.97 101.13,54.97 98.72,56.29\" fill=\"#eef1f5\" stroke=\"#23272e\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/><line x1=\"40\" y1=\"46\" x2=\"96.5\" y2=\"57.91\" stroke=\"#23272e\" stroke-width=\"2\" stroke-linecap=\"round\"/><circle cx=\"40\" cy=\"46\" r=\"2.8\" fill=\"#23272e\" stroke=\"#23272e\" stroke-width=\"1\"/><circle cx=\"96.5\" cy=\"57.91\" r=\"2.8\" fill=\"#23272e\" stroke=\"#23272e\" stroke-width=\"1\"/></svg><circle cx=\"526\" cy=\"180\" r=\"10\" fill=\"#ffffff\" stroke=\"#6b7280\" stroke-width=\"1.6\"/><text x=\"526\" y=\"180.5\" font-size=\"11\" fill=\"#6b7280\" text-anchor=\"middle\" font-weight=\"800\" dominant-baseline=\"middle\">D</text></svg><figcaption>Example: point A is at a corner of the triangle; point B is at the center of the circle. Choice C is correct.</figcaption></figure>\n<div class=\"box strategy\"><div class=\"box-title\">How to solve connection questions</div><ol>\n<li><strong>Name each point in words.</strong> &quot;A is at a <strong>corner</strong> of the triangle. B is at the <strong>center</strong> of the circle.&quot; Saying it in words makes it stick.</li>\n<li><strong>Check one shape at a time.</strong> Go through the choices and cross out every one where the line does not touch the triangle at a corner. Then check the circle&#39;s end of the line.</li>\n<li><strong>Expect the shapes to be turned.</strong> The shapes in the answers may be rotated, and they may sit in different places. What matters is <em>where on each shape</em> the line attaches.</li>\n<li><strong>Look closely at near misses.</strong> The middle of a side is not a corner; a point on the edge of a circle is not the center; an inner corner of a star is not the tip of a point.</li>\n</ol>\n</div><h3>2. Puzzle (assembly) questions</h3>\n<p>The question box shows several separate pieces. You must find the answer choice that shows <strong>how the pieces fit together</strong> into one figure.</p>\n<figure class=\"fig\"><svg role=\"img\" aria-label=\"figure\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 680 300\" width=\"680\" height=\"300\" font-family=\"Segoe UI, Arial, sans-serif\"><svg x=\"190\" y=\"4\" width=\"300\" height=\"130\" viewBox=\"0 0 300 130\"><rect x=\"1\" y=\"1\" width=\"298\" height=\"128\" rx=\"6\" fill=\"#ffffff\" stroke=\"#9aa3ae\" stroke-width=\"1.4\"/><polygon points=\"141.34,65 98.84,22.5 77.59,86.25 98.84,107.5\" fill=\"#eef1f5\" stroke=\"#23272e\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/><polygon points=\"222.41,80.03 170.36,49.97 155.34,76\" fill=\"#eef1f5\" stroke=\"#23272e\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/></svg><text x=\"340\" y=\"150\" font-size=\"11\" fill=\"#6b7280\" text-anchor=\"middle\" font-weight=\"700\" dominant-baseline=\"middle\">question box</text><svg x=\"8\" y=\"166\" width=\"160\" height=\"128\" viewBox=\"0 0 150 120\"><rect x=\"1\" y=\"1\" width=\"148\" height=\"118\" rx=\"6\" fill=\"#ffffff\" stroke=\"#c3cad3\" stroke-width=\"1.2\"/><polygon points=\"105.05,29.95 44.95,29.95 105.05,90.05\" fill=\"#eef1f5\" stroke=\"#23272e\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/><polygon points=\"44.95,29.95 44.95,90.05 105.05,90.05\" fill=\"#eef1f5\" stroke=\"#23272e\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/></svg><circle cx=\"22\" cy=\"180\" r=\"10\" fill=\"#ffffff\" stroke=\"#6b7280\" stroke-width=\"1.6\"/><text x=\"22\" y=\"180.5\" font-size=\"11\" fill=\"#6b7280\" text-anchor=\"middle\" font-weight=\"800\" dominant-baseline=\"middle\">A</text><svg x=\"176\" y=\"166\" width=\"160\" height=\"128\" viewBox=\"0 0 150 120\"><rect x=\"1\" y=\"1\" width=\"148\" height=\"118\" rx=\"6\" fill=\"#ffffff\" stroke=\"#c3cad3\" stroke-width=\"1.2\"/><polygon points=\"44.95,29.95 44.95,90.05 105.05,60 105.05,29.95\" fill=\"#eef1f5\" stroke=\"#23272e\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/><polygon points=\"44.95,90.05 105.05,90.05 105.05,60\" fill=\"#eef1f5\" stroke=\"#23272e\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/></svg><circle cx=\"190\" cy=\"180\" r=\"10\" fill=\"#2f8a57\" stroke=\"#2f8a57\" stroke-width=\"1.6\"/><text x=\"190\" y=\"180.5\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"800\" dominant-baseline=\"middle\">B</text><svg x=\"344\" y=\"166\" width=\"160\" height=\"128\" viewBox=\"0 0 150 120\"><rect x=\"1\" y=\"1\" width=\"148\" height=\"118\" rx=\"6\" fill=\"#ffffff\" stroke=\"#c3cad3\" stroke-width=\"1.2\"/><polygon points=\"75,29.95 44.95,29.95 44.95,90.05 75,90.05\" fill=\"#eef1f5\" stroke=\"#23272e\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/><polygon points=\"105.05,29.95 75,29.95 105.05,90.05\" fill=\"#eef1f5\" stroke=\"#23272e\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/><polygon points=\"75,29.95 75,90.05 105.05,90.05\" fill=\"#eef1f5\" stroke=\"#23272e\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/></svg><circle cx=\"358\" cy=\"180\" r=\"10\" fill=\"#ffffff\" stroke=\"#6b7280\" stroke-width=\"1.6\"/><text x=\"358\" y=\"180.5\" font-size=\"11\" fill=\"#6b7280\" text-anchor=\"middle\" font-weight=\"800\" dominant-baseline=\"middle\">C</text><svg x=\"512\" y=\"166\" width=\"160\" height=\"128\" viewBox=\"0 0 150 120\"><rect x=\"1\" y=\"1\" width=\"148\" height=\"118\" rx=\"6\" fill=\"#ffffff\" stroke=\"#c3cad3\" stroke-width=\"1.2\"/><polygon points=\"44.95,90.05 105.05,90.05 58.17,29.95 44.95,29.95\" fill=\"#eef1f5\" stroke=\"#23272e\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/><polygon points=\"105.05,90.05 105.05,29.95 58.17,29.95\" fill=\"#eef1f5\" stroke=\"#23272e\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/></svg><circle cx=\"526\" cy=\"180\" r=\"10\" fill=\"#ffffff\" stroke=\"#6b7280\" stroke-width=\"1.6\"/><text x=\"526\" y=\"180.5\" font-size=\"11\" fill=\"#6b7280\" text-anchor=\"middle\" font-weight=\"800\" dominant-baseline=\"middle\">D</text></svg><figcaption>Example: a square cut into two pieces. Only choice B uses one triangle and one four-sided piece of exactly the right sizes.</figcaption></figure>\n<div class=\"box strategy\"><div class=\"box-title\">How to solve puzzle questions</div><ol>\n<li><strong>Count the pieces.</strong> The correct answer uses <strong>exactly</strong> the same number of pieces. Cross out any choice with more or fewer.</li>\n<li><strong>Find the most unusual piece</strong> — the biggest one, or the one with a strange angle — and look for it in each choice.</li>\n<li><strong>Check sizes and angles.</strong> A long edge must match a long edge. A square corner stays a square corner. A small sliver cannot turn into a big wedge.</li>\n<li><strong>Pieces may be turned, but not flipped.</strong> In the answers, the pieces can be rotated in any direction. A mirror-image (flipped) version of a piece counts as a different piece.</li>\n<li><strong>Eliminate, then confirm.</strong> When you are down to one choice, quickly match every piece to be sure.</li>\n</ol>\n</div><div class=\"box tip\"><div class=\"box-title\">Use your scratch paper</div><p>Sketch a rough copy of a tricky piece and mark its long side or its square corner. Comparing a quick sketch to each answer is often faster than flipping your eyes back and forth.</p>\n</div><h2>Practice</h2>\n<p>Give yourself about <strong>12 minutes</strong> for these 10 questions. Answers and explanations are at the end of the chapter.</p>\n<div class=\"practice-link\" data-quiz=\"ao1\"><div><strong>Assembling Objects – Practice Set</strong><span>10 questions</span></div><a class=\"btn\" href=\"#/practice/set/ao1\">Practice now</a></div><h2>Answers &amp; Explanations</h2>\n"}